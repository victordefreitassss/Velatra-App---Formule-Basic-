rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function profileExists() {
      return signedIn() && firestore.exists(profilePath(request.auth.uid)) && firestore.get(profilePath(request.auth.uid)).data.get('isSuspended', false) != true;
    }

    function profile() {
      return firestore.get(profilePath(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return profileExists() && profile().role == 'superadmin' &&
        'email_verified' in request.auth.token && request.auth.token.email_verified == true &&
        'email' in request.auth.token && request.auth.token.email == 'victor.defreitas.pro@gmail.com';
    }

    function isStudioManager(clubId) {
      return profileExists() && profile().role == 'manager' && profile().clubId == clubId &&
        firestore.exists(/databases/(default)/documents/clubs/$(clubId)) &&
        firestore.get(/databases/(default)/documents/clubs/$(clubId)).data.get('accountType', '') == 'studio';
    }

    function operationalStaffInClub(clubId) {
      return staffInClub(clubId) || isStudioManager(clubId);
    }

    function staffInClub(clubId) {
      return profileExists() && (
        (profile().clubId == clubId && profile().role in ['owner', 'coach']) || isSuperAdmin()
      );
    }

    function memberPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function memberProfile(uid) {
      return firestore.get(memberPath(uid)).data;
    }

    function canManageMember(memberUid) {
      return profileExists() && firestore.exists(memberPath(memberUid)) && (
        request.auth.uid == memberUid ||
        (isSuperAdmin() && firestore.get(memberPath(memberUid)).data.role == 'member') ||
        (firestore.get(memberPath(memberUid)).data.clubId == profile().clubId &&
          (profile().role == 'owner' ||
            (isStudioManager(profile().clubId) && memberProfile(memberUid).role in ['coach', 'member']) ||
            (profile().role == 'coach' &&
              firestore.get(memberPath(memberUid)).data.role == 'member' &&
              firestore.get(memberPath(memberUid)).data.assignedCoachUid == request.auth.uid)))
      );
    }

    function canReadAvatar(ownerUid) {
      return profileExists() && firestore.exists(memberPath(ownerUid)) && (
        request.auth.uid == ownerUid || isSuperAdmin() ||
        (memberProfile(ownerUid).clubId == profile().clubId && (
          profile().role == 'owner' || isStudioManager(profile().clubId) ||
          (profile().role == 'coach' && (
            memberProfile(ownerUid).role in ['owner', 'coach'] ||
            (memberProfile(ownerUid).role == 'member' &&
              memberProfile(ownerUid).assignedCoachUid == request.auth.uid)
          )) ||
          (profile().role == 'member' && (
            memberProfile(ownerUid).role == 'owner' ||
            (memberProfile(ownerUid).role == 'coach' &&
              'assignedCoachUid' in profile() && profile().assignedCoachUid == ownerUid)
          ))
        ))
      );
    }

    function imageUpload(maxBytes) {
      return request.resource != null && request.resource.size <= maxBytes &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function documentUpload(maxBytes) {
      return request.resource != null && request.resource.size <= maxBytes &&
        request.resource.contentType is string &&
        request.resource.contentType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'text/plain',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    function videoUpload(maxBytes) {
      return request.resource != null && request.resource.size <= maxBytes &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('video/[a-zA-Z0-9.+_-]+');
    }

    function ownerInClub(clubId) {
      return profileExists() && profile().clubId == clubId && profile().role == 'owner';
    }

    match /avatars/{ownerUid}/{fileName} {
      allow read: if canReadAvatar(ownerUid);
      allow create, update: if canManageMember(ownerUid) && imageUpload(5 * 1024 * 1024);
      allow delete: if !isStudioManager(profile().clubId) && canManageMember(ownerUid);
    }

    match /users/{memberUid}/documents/{fileName} {
      allow read: if canManageMember(memberUid);
      allow create, update: if canManageMember(memberUid) && documentUpload(25 * 1024 * 1024);
      allow delete: if !isStudioManager(profile().clubId) && canManageMember(memberUid);
    }

    match /contracts/{memberUid}/{fileName} {
      allow read: if !isStudioManager(profile().clubId) && canManageMember(memberUid);
      allow create, update: if !isStudioManager(profile().clubId) && canManageMember(memberUid) && documentUpload(25 * 1024 * 1024);
      allow delete: if !isStudioManager(profile().clubId) && canManageMember(memberUid);
    }

    match /clubs/{clubId}/{fileName} {
      allow read: if profileExists() && (profile().clubId == clubId || isSuperAdmin());
      allow create, update: if staffInClub(clubId) && imageUpload(5 * 1024 * 1024);
      allow delete: if staffInClub(clubId);
    }

    match /videos/{clubId}/{uploaderUid}/{fileName} {
      // There is no global video catalogue. Preserve club-scoped reads even for admins.
      allow read: if profileExists() && profile().clubId == clubId;
      allow create, update: if signedIn() && request.auth.uid == uploaderUid &&
        operationalStaffInClub(clubId) && videoUpload(50 * 1024 * 1024);
      allow delete: if (signedIn() && request.auth.uid == uploaderUid && operationalStaffInClub(clubId)) || ownerInClub(clubId);
    }

    match /drive/{clubId}/{uploaderUid}/{fileId}/{fileName} {
      function driveFileExists() {
        return firestore.exists(/databases/(default)/documents/driveFiles/$(fileId));
      }

      function driveFile() {
        return firestore.get(/databases/(default)/documents/driveFiles/$(fileId)).data;
      }

      function matchingDriveFile() {
        return driveFileExists() && driveFile().id == fileId &&
          driveFile().clubId == clubId && driveFile().name == fileName &&
          driveFile().path == 'drive/' + clubId + '/' + uploaderUid + '/' + fileId + '/' + fileName;
      }

      function canReadDriveFile() {
        return signedIn() && profileExists() && (profile().clubId == clubId || isSuperAdmin()) && (
          // Staff read before metadata is created: upload -> download URL -> Firestore.
          operationalStaffInClub(clubId) ||
          (matchingDriveFile() &&
            'sharedWith' in driveFile() && driveFile().sharedWith is list &&
            driveFile().sharedWith.hasAny([profile().id]))
        );
      }

      function canDeleteDriveFile() {
        return signedIn() && profileExists() && (profile().clubId == clubId || isSuperAdmin()) && (
          (request.auth.uid == uploaderUid && operationalStaffInClub(clubId)) ||
          isSuperAdmin() || ownerInClub(clubId)
        );
      }

      allow read: if canReadDriveFile();
      allow create, update: if signedIn() && request.auth.uid == uploaderUid && operationalStaffInClub(clubId) &&
        (documentUpload(25 * 1024 * 1024) || imageUpload(25 * 1024 * 1024) || videoUpload(25 * 1024 * 1024));
      allow delete: if canDeleteDriveFile();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
