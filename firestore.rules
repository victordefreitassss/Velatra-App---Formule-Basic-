rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      let oauthEmail = isAuthenticated() && ('email' in request.auth.token) ? request.auth.token.email : null;
      let userPath = isAuthenticated() ? /databases/$(database)/documents/users/$(request.auth.uid) : null;
      return (userPath != null && exists(userPath)) ? get(userPath).data : null;
    }

    function isSameClub(docClubId) {
      let userData = getUserData();
      return isAuthenticated() && userData != null && ('clubId' in userData) && userData.clubId == docClubId;
    }

    function isAdmin() {
      let userData = getUserData();
      return isAuthenticated() && userData != null && ('role' in userData) && (userData.role == 'superadmin' || userData.role == 'owner' || userData.role == 'coach');
    }

    function isSuperAdmin() {
      let userData = getUserData();
      return isAuthenticated() && userData != null && ('role' in userData) && userData.role == 'superadmin';
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && ('email' in request.auth.token) && request.auth.token.email == 'victor.defreitas.pro@gmail.com';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || 
                     isSuperAdmin() || 
                     isSuperAdminEmail() || 
                     (resource != null && 'email' in resource.data && ('email' in request.auth.token) && resource.data.email == request.auth.token.email) || 
                     (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId));
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || 
                     isSuperAdmin() || 
                     isSuperAdminEmail() || 
                     (resource != null && 'clubId' in resource.data && isAdmin() && isSameClub(resource.data.clubId));
      allow delete: if isSuperAdmin() || 
                     isSuperAdminEmail() || 
                     (resource != null && 'clubId' in resource.data && isAdmin() && isSameClub(resource.data.clubId));
    }

    match /clubs/{clubId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isSuperAdminEmail() || isSameClub(clubId);
    }

    match /driveFiles/{fileId} {
      allow read: if isAuthenticated() && (
        (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId)) || 
        (resource != null && 'sharedWith' in resource.data && getUserData() != null && ('id' in getUserData()) && resource.data.sharedWith.hasAny([getUserData().id])) || 
        isSuperAdminEmail()
      );
      allow create: if isAuthenticated() && (
        (request.resource != null && 'clubId' in request.resource.data && isSameClub(request.resource.data.clubId)) || 
        isSuperAdminEmail()
      );
      allow update: if isAuthenticated() && (
        (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId) && (('createdBy' in resource.data && isOwner(resource.data.createdBy)) || isAdmin())) || 
        isSuperAdminEmail()
      );
      allow delete: if isAuthenticated() && (
        (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId) && (('createdBy' in resource.data && isOwner(resource.data.createdBy)) || isAdmin())) || 
        isSuperAdminEmail()
      );
    }

    match /driveFolders/{folderId} {
      allow read: if isAuthenticated() && (
        (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId)) || 
        isSuperAdminEmail()
      );
      allow create: if isAuthenticated() && (
        (request.resource != null && 'clubId' in request.resource.data && isSameClub(request.resource.data.clubId)) || 
        isSuperAdminEmail()
      );
      allow update: if isAuthenticated() && (
        (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId) && (('createdBy' in resource.data && isOwner(resource.data.createdBy)) || isAdmin())) || 
        isSuperAdminEmail()
      );
      allow delete: if isAuthenticated() && (
        (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId) && (('createdBy' in resource.data && isOwner(resource.data.createdBy)) || isAdmin())) || 
        isSuperAdminEmail()
      );
    }

    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || 
                     isSuperAdminEmail() || 
                     (resource != null && 'clubId' in resource.data && isAdmin() && isSameClub(resource.data.clubId));
    }

    match /prospects/{prospectId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() && (
        (resource != null && 'clubId' in resource.data && isSameClub(resource.data.clubId)) || 
        isSuperAdminEmail()
      );
    }

    match /test/{docId} {
      allow read: if true;
    }

    // Default rule for all other collections
    match /{document=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isSameClub(request.resource.data.clubId) || 
        isSuperAdmin() ||
        isSuperAdminEmail()
      );
      allow delete: if isAuthenticated() && (
        isSameClub(resource.data.clubId) || 
        isSuperAdmin() ||
        isSuperAdminEmail()
      );
    }
  }
}
