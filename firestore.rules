rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profileExists() {
      let caller = get(userPath()).data;
      return signedIn() && caller != null && caller.get('isSuspended', false) != true;
    }

    function activeClub(clubId) {
      let club = get(clubDocumentPath(clubId)).data;
      return club != null && club.get('isActive', false) == true;
    }

    function profile() {
      return get(userPath()).data;
    }

    function isSuperAdminEmail() {
      return signedIn() && 'email' in request.auth.token && 'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true && request.auth.token.email == 'victor.defreitas.pro@gmail.com';
    }

    function isSuperAdmin() {
      return isSuperAdminEmail() && profileExists() && profile().role == 'superadmin';
    }

    function isStaff() {
      return profileExists() && profile().role in ['superadmin', 'owner', 'coach'];
    }

    function isCoach() {
      return profileExists() && profile().role == 'coach';
    }

    function canManageClubSettings(clubId) {
      return profileExists() && profile().clubId == clubId &&
        ((profile().role == 'owner' && activeClub(clubId)) || (profile().role == 'superadmin' && isSuperAdminEmail()));
    }

    function isStudioManager(clubId) {
      return profileExists() && profile().role == 'manager' && profile().clubId == clubId &&
        exists(/databases/$(database)/documents/clubs/$(clubId)) &&
        get(/databases/$(database)/documents/clubs/$(clubId)).data.get('accountType', '') == 'studio' && activeClub(clubId);
    }

    function canManageTeam(clubId) {
      return canManageClubSettings(clubId) || isStudioManager(clubId);
    }

    function canAssignMembers(clubId) {
      return canManageTeam(clubId);
    }

    function canPerformDestructiveClubActions(clubId) {
      return canManageClubSettings(clubId);
    }

    function operationalStaffInClub(clubId) {
      return staffInClub(clubId) || isStudioManager(clubId);
    }

    function isSameClub(clubId) {
      return profileExists() && profile().clubId == clubId && activeClub(clubId);
    }

    function staffInClub(clubId) {
      return isStaff() && (isSuperAdmin() || isSuperAdminEmail() || isSameClub(clubId));
    }

    function canAccessGlobalFinances(clubId) {
      return staffInClub(clubId) && (profile().role != 'coach' ||
        !exists(clubDocumentPath(clubId)) || get(clubDocumentPath(clubId)).data.get('accountType', '') != 'studio');
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwnId(value) {
      return profileExists() && (value == request.auth.uid || value == profile().id);
    }

    function ownsRecord(data) {
      return profileExists() && (
        ('memberId' in data && isOwnId(data.memberId)) ||
        ('userId' in data && isOwnId(data.userId)) ||
        ('adherentId' in data && isOwnId(data.adherentId)) ||
        (!('memberId' in data) && !('userId' in data) && !('adherentId' in data) &&
          (('from' in data && isOwnId(data.from)) || ('to' in data && isOwnId(data.to))))
      );
    }

    function hasAssignedMember(memberId) {
      return profileExists() && profile().role == 'coach' &&
        'assignedMemberIds' in profile() && profile().assignedMemberIds is list &&
        profile().assignedMemberIds.hasAny([memberId]);
    }

    function coachAssignedRecord(data) {
      return profileExists() && profile().role == 'coach' && isSameClub(data.clubId) &&
        data.assignedCoachUid == request.auth.uid;
    }

    function coachCanManageAssignedRecord(data) {
      return profileExists() && profile().role == 'coach' && isSameClub(data.clubId) &&
        data.assignedCoachUid == request.auth.uid && 'assignedMemberIds' in profile() &&
        profile().assignedMemberIds is list && (
          ('memberId' in data && profile().assignedMemberIds.hasAny([data.memberId])) ||
          ('userId' in data && profile().assignedMemberIds.hasAny([data.userId])) ||
          ('adherentId' in data && profile().assignedMemberIds.hasAny([data.adherentId]))
        );
    }

    function coachOwnsConversation(data) {
      return profileExists() && profile().role == 'coach' && isSameClub(data.clubId) &&
        data.assignedCoachUid == request.auth.uid &&
        ((data.from == profile().id && hasAssignedMember(data.to)) ||
          (data.to == profile().id && hasAssignedMember(data.from)));
    }

    function clubDocumentPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId);
    }

    function userDocumentPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isConversationWith(data, contact) {
      return ((data.from == profile().id && data.to == contact.id) ||
        (data.to == profile().id && data.from == contact.id));
    }

    function memberOwnsConversation(data) {
      return profileExists() && profile().role == 'member' && isSameClub(data.clubId) &&
        !('memberId' in data) && !('userId' in data) && !('adherentId' in data) &&
        data.from is int && data.to is int && (
        ('assignedCoachUid' in profile() && 'assignedCoachUid' in data &&
          data.assignedCoachUid == profile().assignedCoachUid &&
          exists(userDocumentPath(profile().assignedCoachUid)) &&
          get(userDocumentPath(profile().assignedCoachUid)).data.role == 'coach' &&
          get(userDocumentPath(profile().assignedCoachUid)).data.clubId == data.clubId &&
          isConversationWith(data, get(userDocumentPath(profile().assignedCoachUid)).data)) ||
        (!('assignedCoachUid' in data) && exists(clubDocumentPath(data.clubId)) &&
          get(clubDocumentPath(data.clubId)).data.accountType == 'solo' &&
          exists(userDocumentPath(get(clubDocumentPath(data.clubId)).data.ownerId)) &&
          get(userDocumentPath(get(clubDocumentPath(data.clubId)).data.ownerId)).data.role == 'owner' &&
          get(userDocumentPath(get(clubDocumentPath(data.clubId)).data.ownerId)).data.clubId == data.clubId &&
          isConversationWith(data, get(userDocumentPath(get(clubDocumentPath(data.clubId)).data.ownerId)).data))
      );
    }

    function consistentMemberIdentity(data) {
      return (!('memberId' in data) || !('userId' in data) || data.memberId == data.userId) &&
        (!('memberId' in data) || !('adherentId' in data) || data.memberId == data.adherentId) &&
        (!('userId' in data) || !('adherentId' in data) || data.userId == data.adherentId);
    }

    function clubUnchanged() {
      return request.resource.data.clubId == resource.data.clubId;
    }

    function canManageMemberRecord(data) {
      return consistentMemberIdentity(data) && profileExists() && data.clubId == profile().clubId &&
        (coachCanManageAssignedRecord(data) || canAssignMembers(data.clubId));
    }

    function canReadUser(userId, data) {
      // The verified, hard-coded super-admin needs a cross-club roster for the
      // platform console. Ordinary owners, coaches and members remain scoped.
      return isSuperAdmin() || isSuperAdminEmail() || isSelf(userId) || canManageTeam(data.clubId) ||
        (profileExists() && profile().role == 'coach' &&
          isSameClub(data.clubId) && data.role == 'member' &&
          'assignedCoachUid' in data && data.assignedCoachUid == request.auth.uid);
    }

    function canReadMemberRecord(data) {
      return canManageTeam(data.clubId) ||
        (isSameClub(data.clubId) && ownsRecord(data)) || coachAssignedRecord(data);
    }

    function canReadFinancialRecord(data) {
      return !isStudioManager(data.clubId) && canReadMemberRecord(data);
    }

    function canDeleteMemberRecord(data) {
      return !isStudioManager(data.clubId) && canManageMemberRecord(data);
    }

    function canWriteClubRecord(data) {
      return operationalStaffInClub(data.clubId);
    }

    function canCreateOwnRecord(data) {
      return consistentMemberIdentity(data) && isSameClub(data.clubId) && ownsRecord(data) &&
        (!('assignedCoachUid' in data) ||
          ('assignedCoachUid' in profile() && data.assignedCoachUid == profile().assignedCoachUid));
    }

    function noLegacyStripeSecret(data) {
      return !('settings' in data) || !('payment' in data.settings) || !('stripeSecretKey' in data.settings.payment);
    }

    function safeClubSettingsUpdate() {
      let before = resource.data.get('settings', {});
      let after = request.resource.data.get('settings', {});
      let paymentBefore = before.get('payment', {});
      let paymentAfter = after.get('payment', {});
      // Preserve server-owned legacy keys, but never allow their addition,
      // removal or change through a nested/partial client write.
      return after is map && before is map && after.diff(before).affectedKeys().hasOnly([
        'defaultProgramDuration', 'onboarding', 'finances', 'loyalty', 'payment', 'booking'
      ]) && paymentAfter is map && paymentBefore is map &&
        paymentAfter.diff(paymentBefore).affectedKeys().hasOnly(['acceptedMethods', 'autoCollection']);
    }

    match /test/{documentId} {
      allow get: if documentId == 'connection';
      allow list, write: if false;
    }

    match /users/{userId} {
      // A signed-in signup must be able to observe its not-yet-created profile.
      allow get: if isSelf(userId) || (resource != null && canReadUser(userId, resource.data));
      allow list: if resource != null && canReadUser(userId, resource.data);
      // All profiles, including public member sign-ups, are created by the
      // server so clients cannot choose their own legacy numeric member ID.
      allow create: if false;
      allow update: if (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coachingNotesHistory']) || (request.resource.data.coachingNotesHistory is list && request.resource.data.coachingNotesHistory.size() <= 200)) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stripeCustomerId', 'stripeCustomerClubId', 'credits', 'sessionCredits', 'paymentStatus']) && ((
        isSelf(userId) && profileExists() &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.firebaseUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'avatar', 'gender', 'age', 'weight', 'height', 'objectifs', 'notes',
          'experienceLevel', 'trainingDays', 'sessionDuration', 'equipment', 'injuries',
          'blessures', 'birthDate', 'phone', 'address', 'measurements', 'onboardingCompleted',
          'planRequested', 'fcmToken', 'updatedAt'
        ])
      ) || (resource != null && !isSelf(userId) && isStudioManager(resource.data.clubId) &&
        resource.data.role in ['coach', 'member'] &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.firebaseUid == resource.data.firebaseUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'avatar', 'gender', 'age', 'weight', 'height', 'objectifs', 'notes', 'coachingNotesHistory',
          'experienceLevel', 'trainingDays', 'sessionDuration', 'equipment', 'injuries',
          'blessures', 'birthDate', 'phone', 'address', 'measurements', 'status',
          'isSuspended', 'planRequested', 'onboardingCompleted', 'documents', 'updatedAt'
        ])
      ) || (resource != null && !isSelf(userId) && canManageClubSettings(resource.data.clubId) && (
        isSuperAdmin() || isSuperAdminEmail() ||
        (request.resource.data.role == resource.data.role &&
          request.resource.data.clubId == resource.data.clubId &&
          request.resource.data.firebaseUid == resource.data.firebaseUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'avatar', 'gender', 'age', 'weight', 'height', 'objectifs', 'notes', 'coachingNotesHistory',
            'experienceLevel', 'trainingDays', 'sessionDuration', 'equipment', 'injuries',
            'blessures', 'birthDate', 'phone', 'address', 'measurements', 'status',
            'isSuspended', 'credits', 'sessionCredits', 'paymentStatus', 'planRequested',
            'onboardingCompleted', 'documents', 'updatedAt'
          ]))
      )) || (resource != null && !isSelf(userId) && profileExists() && profile().role == 'coach' &&
        resource.data.role == 'member' && resource.data.assignedCoachUid == request.auth.uid &&
        isSameClub(resource.data.clubId) && hasAssignedMember(resource.data.id) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.firebaseUid == resource.data.firebaseUid &&
        request.resource.data.assignedCoachUid == resource.data.assignedCoachUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'avatar', 'gender', 'age', 'weight', 'height', 'objectifs', 'notes', 'coachingNotesHistory',
          'experienceLevel', 'trainingDays', 'sessionDuration', 'equipment', 'injuries',
          'blessures', 'birthDate', 'phone', 'address', 'measurements', 'status',
          'onboardingCompleted', 'planRequested', 'updatedAt'
        ])));
      allow delete: if resource != null && canPerformDestructiveClubActions(resource.data.clubId) &&
        (resource.data.role != 'owner' || isSuperAdmin() || isSuperAdminEmail());
    }

    match /clubs/{clubId} {
      // Public onboarding validates club codes through a server endpoint and
      // returns no club profile fields to unauthenticated visitors.
      // Keep the canonical status readable so a suspended tenant can display
      // the suspension screen and observe an authorized reactivation.
      allow get: if noLegacyStripeSecret(resource.data) && (isSuperAdminEmail() ||
        (signedIn() && exists(userPath()) && get(userPath()).data.get('isSuspended', false) != true &&
          get(userPath()).data.clubId == clubId));
      allow list: if isSuperAdmin() || isSuperAdminEmail();
      allow create: if false;
      // An allowlist protects canonical/legacy SaaS fields and future aliases.
      // Even the platform browser must use the authenticated server command.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'address', 'description', 'horaires', 'googleReview',
          'mapsLink', 'logo', 'primaryColor', 'coaches', 'settings'
        ]) && safeClubSettingsUpdate() &&
        staffInClub(clubId) && (isSuperAdmin() || isSuperAdminEmail() ||
        (profile().role == 'owner' && request.resource.data.ownerId == resource.data.ownerId && noLegacyStripeSecret(request.resource.data)));
      allow delete: if isSuperAdmin() || isSuperAdminEmail();
    }

    match /driveFiles/{fileId} {
      allow read: if operationalStaffInClub(resource.data.clubId) ||
        (isSameClub(resource.data.clubId) && profileExists() && 'sharedWith' in resource.data && resource.data.sharedWith.hasAny([profile().id]));
      allow create: if canWriteClubRecord(request.resource.data);
      allow update: if resource != null && clubUnchanged() && canWriteClubRecord(resource.data) &&
        (isSuperAdmin() || canManageClubSettings(resource.data.clubId) || resource.data.uploadedBy == profile().id);
      allow delete: if resource != null && canWriteClubRecord(resource.data) &&
        (isSuperAdmin() || canManageClubSettings(resource.data.clubId) || resource.data.uploadedBy == profile().id);
    }

    match /driveFolders/{folderId} {
      allow read, delete: if resource != null && operationalStaffInClub(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && operationalStaffInClub(resource.data.clubId);
      allow create: if operationalStaffInClub(request.resource.data.clubId);
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn() && (resource.data.clubId == 'global' || isSameClub(resource.data.clubId));
      allow create: if operationalStaffInClub(request.resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && operationalStaffInClub(resource.data.clubId);
      allow delete: if resource != null && operationalStaffInClub(resource.data.clubId);
    }

    match /prospects/{prospectId} {
      // Creation and analytics transitions are atomic server operations with salesEvents.
      allow create: if false;
      allow read: if resource != null && operationalStaffInClub(resource.data.clubId);
      allow delete: if resource != null && operationalStaffInClub(resource.data.clubId)
        && resource.data.get('salesVersion', 0) != 2
        && resource.data.status in ['lead', 'contacted']
        && resource.data.get('notesHistory', []).size() == 0
        && resource.data.get('activityHistory', []).size() == 0
        && !('convertedMemberUid' in resource.data);
      allow update: if resource != null && clubUnchanged() && operationalStaffInClub(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'notesHistory', 'activityHistory']);
    }

    match /salesEvents/{eventId} { allow read, write: if false; }

    match /programs/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data);
      allow update: if canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data);
      allow delete: if canDeleteMemberRecord(resource.data);
    }
    match /archivedPrograms/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data);
      allow update: if canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data);
      allow delete: if canDeleteMemberRecord(resource.data);
    }
    match /performances/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data) || canCreateOwnRecord(request.resource.data);
      allow update: if (canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data)) ||
        (canCreateOwnRecord(resource.data) && canCreateOwnRecord(request.resource.data));
      allow delete: if canDeleteMemberRecord(resource.data) || canCreateOwnRecord(resource.data);
    }
    match /logs/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      // Feedback is written once by the authenticated server API after the real workout exists.
      allow create: if !('memberFeedback' in request.resource.data) &&
        (canManageMemberRecord(request.resource.data) || canCreateOwnRecord(request.resource.data));
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberFeedback']) &&
        (!('memberFeedback' in resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rpe'])) &&
        ((canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data)) ||
        (canCreateOwnRecord(resource.data) && canCreateOwnRecord(request.resource.data)));
      allow delete: if !('memberFeedback' in resource.data) &&
        (canDeleteMemberRecord(resource.data) || canCreateOwnRecord(resource.data));
    }
    match /bodyData/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data) || canCreateOwnRecord(request.resource.data);
      allow update: if (canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data)) ||
        (canCreateOwnRecord(resource.data) && canCreateOwnRecord(request.resource.data));
      allow delete: if canDeleteMemberRecord(resource.data) || canCreateOwnRecord(resource.data);
    }
    match /nutritionPlans/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data);
      allow update: if canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data);
      allow delete: if canDeleteMemberRecord(resource.data);
    }
    match /nutritionLogs/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data) || canCreateOwnRecord(request.resource.data);
      allow update: if (canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data)) ||
        (canCreateOwnRecord(resource.data) && canCreateOwnRecord(request.resource.data));
      allow delete: if canDeleteMemberRecord(resource.data) || canCreateOwnRecord(resource.data);
    }
    match /subscriptions/{documentId} {
      allow read: if canReadFinancialRecord(resource.data);
      allow write: if false; // Financial authority and grants belong to server orchestration.
    }
    match /payments/{documentId} {
      allow read: if canReadFinancialRecord(resource.data);
      allow write: if false; // Financial authority and grants belong to server orchestration.
    }
    match /supplementOrders/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data) || canCreateOwnRecord(request.resource.data);
      allow update: if canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data);
      allow delete: if canDeleteMemberRecord(resource.data);
    }
    match /progressPhotos/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      allow create: if canManageMemberRecord(request.resource.data) || canCreateOwnRecord(request.resource.data);
      allow update: if (canManageMemberRecord(resource.data) && canManageMemberRecord(request.resource.data)) ||
        (canCreateOwnRecord(resource.data) && canCreateOwnRecord(request.resource.data));
      allow delete: if canDeleteMemberRecord(resource.data) || canCreateOwnRecord(resource.data);
    }
    match /messages/{documentId} {
      // UID-backed server writes; numeric participation retained for existing realtime queries.
      allow read: if profileExists() && isSameClub(resource.data.clubId) &&
        (resource.data.from == profile().id || resource.data.to == profile().id) &&
        (!isCoach() || coachOwnsConversation(resource.data));
      allow create, delete: if false;
      allow update: if profileExists() && isSameClub(resource.data.clubId) &&
        resource.data.to == profile().id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;
    }
    match /bookings/{documentId} {
      allow read: if canReadMemberRecord(resource.data);
      // All reservation mutations (including CRM trials) use authenticated server transactions.
      allow create, update: if false;
      allow delete: if false;
    }
    match /notifications/{documentId} {
      // Historical inbox only: own read, immutable via SDK; V2 creation is server-owned.
      allow read: if profileExists() && isSameClub(resource.data.clubId) && resource.data.userId == profile().id;
      allow create, update, delete: if false;
    }
    match /notificationInboxes/{inboxId} {
      allow read, write: if false;
      match /items/{notificationId} {
        allow read: if profileExists() && resource.data.recipientUid == request.auth.uid && isSameClub(resource.data.clubId) &&
          activeClub(resource.data.clubId);
        allow create, update, delete: if false;
      }
    }
    match /pushDevices/{document=**} { allow read, write: if false; }
    match /notificationPreferences/{document=**} { allow read, write: if false; }
    match /pushTokenOwners/{document=**} { allow read, write: if false; }
    match /presets/{documentId} {
      allow read: if signedIn() && (resource.data.clubId == 'global' || isSameClub(resource.data.clubId));
      allow create: if canWriteClubRecord(request.resource.data);
      allow update: if resource != null && clubUnchanged() && canWriteClubRecord(resource.data);
      allow delete: if resource != null && canWriteClubRecord(resource.data);
    }
    match /nutritionPresets/{documentId} {
      allow read: if signedIn() && (resource.data.clubId == 'global' || isSameClub(resource.data.clubId));
      allow create: if canWriteClubRecord(request.resource.data);
      allow update: if resource != null && clubUnchanged() && canWriteClubRecord(resource.data);
      allow delete: if resource != null && canWriteClubRecord(resource.data);
    }
    match /supplementProducts/{documentId} {
      allow read: if signedIn() && isSameClub(resource.data.clubId);
      allow create: if canWriteClubRecord(request.resource.data);
      allow update: if resource != null && clubUnchanged() && canWriteClubRecord(resource.data);
      allow delete: if resource != null && canWriteClubRecord(resource.data);
    }
    match /products/{documentId} {
      allow read: if signedIn() && isSameClub(resource.data.clubId);
      allow create: if canWriteClubRecord(request.resource.data);
      allow update: if resource != null && clubUnchanged() && canWriteClubRecord(resource.data);
      allow delete: if resource != null && canWriteClubRecord(resource.data);
    }
    match /plans/{documentId} {
      allow read: if signedIn() && isSameClub(resource.data.clubId);
      allow write: if false;
    }
    match /feed/{documentId} {
      allow read: if signedIn() && isSameClub(resource.data.clubId);
      allow create: if canCreateOwnRecord(request.resource.data) || canWriteClubRecord(request.resource.data);
      allow update: if resource != null && clubUnchanged() && (canWriteClubRecord(resource.data) || (canCreateOwnRecord(resource.data) && canCreateOwnRecord(request.resource.data)));
      allow delete: if resource != null && (canWriteClubRecord(resource.data) || canCreateOwnRecord(resource.data));
    }

    match /tasks/{documentId} {
      allow read, delete: if resource != null && operationalStaffInClub(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && operationalStaffInClub(resource.data.clubId);
      allow create: if operationalStaffInClub(request.resource.data.clubId);
    }
    match /newsletters/{documentId} {
      allow read, delete: if resource != null && operationalStaffInClub(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && operationalStaffInClub(resource.data.clubId);
      allow create: if operationalStaffInClub(request.resource.data.clubId);
    }
    match /expenses/{documentId} {
      allow read, delete: if resource != null && canAccessGlobalFinances(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && canAccessGlobalFinances(resource.data.clubId);
      allow create: if canAccessGlobalFinances(request.resource.data.clubId);
    }
    match /invoices/{documentId} {
      allow read: if canReadFinancialRecord(resource.data);
      allow write: if false;
    }
    match /fixedCosts/{documentId} {
      allow read, delete: if resource != null && canAccessGlobalFinances(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && canAccessGlobalFinances(resource.data.clubId);
      allow create: if canAccessGlobalFinances(request.resource.data.clubId);
    }
    match /crmClients/{documentId} {
      allow read, delete: if resource != null && staffInClub(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && staffInClub(resource.data.clubId);
      allow create: if staffInClub(request.resource.data.clubId);
    }
    match /crmFormulas/{documentId} {
      allow read, delete: if resource != null && staffInClub(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && staffInClub(resource.data.clubId);
      allow create: if staffInClub(request.resource.data.clubId);
    }
    match /manualStats/{documentId} {
      allow read, delete: if resource != null && canAccessGlobalFinances(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && canAccessGlobalFinances(resource.data.clubId);
      allow create: if canAccessGlobalFinances(request.resource.data.clubId);
    }
    match /pendingProspects/{documentId} {
      allow read, delete: if resource != null && staffInClub(resource.data.clubId);
      allow update: if resource != null && clubUnchanged() && staffInClub(resource.data.clubId);
      allow create: if staffInClub(request.resource.data.clubId);
    }

    match /system_announcements/{documentId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin() || isSuperAdminEmail();
    }
    match /admin_audit_logs/{documentId} {
      allow read, write: if isSuperAdmin() || isSuperAdminEmail();
    }
    match /stripeSecrets/{documentId} {
      allow read, write: if false;
    }

    // New collections must receive explicit access rules before clients can use them.
    // Longitudinal follow-up is served exclusively through role-scoped API endpoints.
    match /coachingJourneys/{documentId} { allow read, write: if false; }
    match /coachCheckInTemplates/{documentId} { allow read, write: if false; }
    match /coachCheckInAssignments/{documentId} { allow read, write: if false; }
    match /coachCheckInResponses/{documentId} { allow read, write: if false; }
    match /coachHabits/{documentId} { allow read, write: if false; }
    match /coachHabitEntries/{documentId} { allow read, write: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
