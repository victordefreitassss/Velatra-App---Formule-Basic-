{
  "name": "velatra-body-coach-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/patch-jwks-esm.mjs",
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "NODE_OPTIONS=--max_old_space_size=4096 vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "pretest": "node scripts/assert-test-emulators.mjs && node --test scripts/ci/*.test.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:emulators": "npx --yes firebase-tools@15.31.0 emulators:exec --project demo-velatra --config firebase.qa.json --only auth,firestore,storage \"npm test\"",
    "dev:qa": "GCLOUD_PROJECT=demo-velatra FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 VITE_USE_FIREBASE_EMULATORS=true CLUB_INVITE_CODE=local-qa-invite tsx server.ts"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@sentry/react": "^11.3.0",
    "@stripe/stripe-js": "^9.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "firebase": "^12.9.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.34.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^2.15.4",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "puppeteer": "^25.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
